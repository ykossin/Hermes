[Unit]
Description=Baseline Hermes-KMS virtual monitor for headless Plasma desktop
After=graphical-session.target hermes.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/headless-desktop.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
